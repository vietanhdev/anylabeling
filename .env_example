# Copy this file to .env before the first Docker Compose build.
# Set these values to the output of `id -u` and `id -g` on the host.
LOCAL_UID=1000
LOCAL_GID=1000

# Set this value to the output of `hostname` on the host.
# Matching the host name supports hostname-specific X11 cookies.
HOST_HOSTNAME=

# Existing host dataset directory, relative to the repository or absolute.
ANYLABELING_DATA_DIR=./data

# Use the current desktop session's authority file, with the usual fallback.
# Set an explicit path here if your desktop stores it elsewhere.
ANYLABELING_XAUTHORITY=${XAUTHORITY:-${HOME}/.Xauthority}
